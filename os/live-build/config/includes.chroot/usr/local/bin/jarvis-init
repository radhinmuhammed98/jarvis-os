#!/usr/bin/env bash
set -euo pipefail
echo "================================================================="
echo "               JARVIS OS - System Initialization                 "
echo "================================================================="
if command -v python3 >/dev/null 2>&1; then
    python3 -m system.init || echo "[JARVIS INIT] System init completed with warnings."
else
    echo "[JARVIS INIT] Python runtime not found!"
    return 1 2>/dev/null || false
fi
echo "[JARVIS INIT] Boot complete. JARVIS OS is ready."
