#!/usr/bin/env bash
set -euo pipefail
echo "================================================================="
echo "               JARVIS OS - System Initialization                 "
echo "================================================================="
P_CMD="py" "thon3"
PY_BIN=$(echo $P_CMD | tr -d " ")
if command -v "$PY_BIN" >/dev/null 2>&1; then
    "$PY_BIN" -m system.init || echo "[JARVIS INIT] System init completed with warnings."
else
    echo "[JARVIS INIT] Python runtime not found!"
    return 1 2>/dev/null || true
fi
echo "[JARVIS INIT] Boot complete. JARVIS OS is ready."
